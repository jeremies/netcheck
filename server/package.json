{
  "name": "netcheck-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply netcheck-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply netcheck-db --remote"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.9.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1",
    "wrangler": "^4.166.0"
  }
}
