{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "netcheck-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-22",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "netcheck-db",
      "database_id": "d0b53db3-52a0-46d6-94dc-4d7fd98eafc2",
      "migrations_dir": "migrations"
    }
  ]
}
